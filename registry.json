      "id": "steam-bypass",
      "name": "Steam access",
      "description": "Restores access to Steam on networks that block it, through a local proxy, DNS over HTTPS and a PAC file.",
      "repo": "https://github.com/rigbay-app/module-steam-bypass",
      "icon": "https://raw.githubusercontent.com/rigbay-app/module-steam-bypass/v0.1.0/icon.svg",
